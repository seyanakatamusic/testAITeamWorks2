# terraform init -backend-config=backend.hcl で読み込む値の例。
# アカウント固有値のためgit管理対象外（.gitignoreでbackend.hclを除外）。
# 実際の値はBOOTSTRAP.mdの手順で作成したS3バケット/DynamoDBテーブル名に置き換える。

bucket         = "attendance-saas-tfstate-production-REPLACE_ME"
region         = "ap-northeast-1"
dynamodb_table = "attendance-saas-tfstate-lock-production"
